# Copia este archivo como .env y completa los valores.

# Postgres (Neon). Usa la URL con pooler que da el panel de Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Secreto para firmar las sesiones (JWT). Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Token de UploadThing para subir logos, portadas, galería y fotos de barberos.
UPLOADTHING_TOKEN=""

# Secreto del cron diario (/api/cron/daily). Vercel lo envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Email que se convierte en ADMIN de la plataforma al registrarse, solo si aún no existe ningún ADMIN.
ADMIN_BOOTSTRAP_EMAIL=""

# Modo "próximamente": con "true" todo el sitio muestra /coming-soon y las APIs responden 503 (el cron sigue).
MAINTENANCE_MODE="false"
# Abre cualquier URL con ?preview=<este valor> para recibir una cookie (30 días) y usar el sitio normal.
MAINTENANCE_BYPASS_SECRET=""
