generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(uuid())
  name            String?
  email           String        @unique
  phone           String        @unique
  password        String
  role            Role          @default(CUSTOMER)
  isBanned        Boolean       @default(false)
  barberProfile   Barber?
  appointments    Appointment[]
  ownedBusinesses Business[]    @relation("BusinessOwner")
  createdAt       DateTime      @default(now())
}

enum Role {
  CUSTOMER
  BARBER
  OWNER
  ADMIN
}

model Business {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  phone       String?
  address     String?
  logoUrl     String?
  coverUrl    String?
  active      Boolean @default(true)

  ownerId String
  owner   User   @relation("BusinessOwner", fields: [ownerId], references: [id])

  settings     BusinessSettings?
  barbers      Barber[]
  services     Service[]
  appointments Appointment[]
  gallery      BusinessGallery[]
  posts        BusinessPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([slug])
}

model BusinessSettings {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id])
  isServiceActive    Boolean  @default(true)
  maintenanceMessage String   @default("El servicio está temporalmente inactivo. Por favor, vuelve más tarde.")
  updatedAt          DateTime @updatedAt
}

model Appointment {
  id   String   @id @default(uuid())
  date DateTime

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@index([businessId])
  @@index([barberId])
  @@index([userId])
  @@index([serviceId])
  @@index([date])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Barber {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  status    BarberStatus @default(PENDING)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  appointments Appointment[]
  availability Availability[]
  exceptions   BarberException[]
  services     Service[]
  profileImageUrl String?

  @@index([businessId])
}

enum BarberStatus {
  PENDING
  APPROVED
  REJECTED
}

model Availability {
  id String @id @default(uuid())

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  dayOfWeek  Int
  startTime  String
  endTime    String
  breakStart String?
  breakEnd   String?

  createdAt DateTime @default(now())

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

model Service {
  id        String   @id @default(uuid())
  name      String
  price     Float
  duration  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  appointments Appointment[]

  @@unique([businessId, barberId, name])
  @@index([barberId])
}

model BarberException {
  id        String   @id @default(uuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model SystemSettings {
  id                 String   @id @default("global")
  isServiceActive    Boolean  @default(true)
  maintenanceMessage String   @default("El servicio está temporalmente inactivo. Por favor, vuelve más tarde.")
  updatedAt          DateTime @updatedAt
}

model BusinessGallery {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  imageUrl String
  caption  String?
  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([businessId])
}

model BusinessPost {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  content  String
  imageUrl String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}
