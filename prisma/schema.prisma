generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String                @id @default(uuid())
  name            String?
  email           String                @unique
  phone           String                @unique
  password        String
  role            Role                  @default(CUSTOMER)
  isBanned        Boolean               @default(false)
  // Versión de los Términos y el Aviso de Privacidad que aceptó y cuándo
  termsVersion    String?
  termsAcceptedAt DateTime?
  // Cuenta eliminada por el usuario: sus datos se anonimizan y ya no puede iniciar sesión
  deletedAt       DateTime?
  // Sube al cambiar la contraseña o al cerrar todas las sesiones: invalida los tokens anteriores
  sessionVersion  Int                   @default(0)
  barberProfile   Barber?
  appointments    Appointment[]
  ownedBusinesses Business[]            @relation("BusinessOwner")
  businessBans    BusinessCustomerBan[]
  createdAt       DateTime              @default(now())

  paymentsRecorded BusinessPayment[]
  auditEntries     AuditLog[]
}

enum Role {
  CUSTOMER
  BARBER
  OWNER
  ADMIN
}

model Business {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  phone       String?
  address     String?
  logoUrl     String?
  coverUrl    String?
  active      Boolean @default(true)
  timezone    String  @default("America/Tijuana")

  ownerId String
  owner   User   @relation("BusinessOwner", fields: [ownerId], references: [id])

  settings     BusinessSettings?
  barbers      Barber[]
  services     Service[]
  appointments Appointment[]
  gallery      BusinessGallery[]
  posts        BusinessPost[]
  customerBans BusinessCustomerBan[]
  payments     BusinessPayment[]

  // Única fuente de verdad de plan, estado y vigencia de la suscripción
  subscription BusinessSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model BusinessSubscription {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan          BusinessPlanType      @default(BASIC)
  billingStatus BusinessBillingStatus @default(ACTIVE)
  provider      SubscriptionProvider  @default(MANUAL)

  setupFeeCents     Int    @default(0)
  monthlyPriceCents Int    @default(15000)
  currency          String @default("MXN")

  providerCustomerId     String?
  providerSubscriptionId String?
  providerPriceId        String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingStatus])
  @@index([plan])
  @@index([provider])
}

model BusinessSettings {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id])
  isServiceActive    Boolean  @default(true)
  // Las reservas en línea quedan confirmadas al instante; si no, el barbero las confirma
  autoConfirm        Boolean  @default(true)
  maintenanceMessage String   @default("El servicio está temporalmente inactivo. Por favor, vuelve más tarde.")
  updatedAt          DateTime @updatedAt
}

model Appointment {
  id   String   @id @default(uuid())
  date DateTime

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  // Sin usuario cuando la barbería registra a un cliente sin cuenta
  userId String?
  // Restrict: la cuenta se anonimiza al eliminarla, nunca se borra la fila
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  walkInName  String?
  walkInPhone String?

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  status    AppointmentStatus @default(PENDING)
  // Solo en citas canceladas: para explicarle al cliente qué pasó
  cancelledBy AppointmentCanceller?
  createdAt DateTime          @default(now())

  @@index([businessId])
  @@index([barberId])
  @@index([userId])
  @@index([serviceId])
  @@index([date])
  @@index([barberId, date])
}

enum AppointmentCanceller {
  CUSTOMER
  BUSINESS
  SYSTEM
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Barber {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  status    BarberStatus @default(PENDING)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  appointments    Appointment[]
  availability    Availability[]
  exceptions      BarberException[]
  services        Service[]
  profileImageUrl String?

  @@index([businessId])
}

enum BarberStatus {
  PENDING
  APPROVED
  REJECTED
}

model Availability {
  id String @id @default(uuid())

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  dayOfWeek  Int
  startTime  String
  endTime    String
  breakStart String?
  breakEnd   String?

  createdAt DateTime @default(now())

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

model Service {
  id         String   @id @default(uuid())
  name       String
  priceCents Int // Precio en centavos (MXN), igual que la facturación
  duration   Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  appointments Appointment[]

  @@unique([businessId, barberId, name])
  @@index([barberId])
}

model BarberException {
  id        String   @id @default(uuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([barberId])
}

model SystemSettings {
  id                 String   @id @default("global")
  isServiceActive    Boolean  @default(true)
  maintenanceMessage String   @default("El servicio está temporalmente inactivo. Por favor, vuelve más tarde.")
  // Cómo pagar la membresía; solo lo ven los dueños con sesión iniciada
  paymentInstructions String?
  updatedAt          DateTime @updatedAt
}

model BusinessGallery {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  imageUrl String
  caption  String?
  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([businessId])
}

model BusinessPost {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  content  String
  imageUrl String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

enum BusinessBillingStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  TRIALING
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

// Pago recibido por fuera de la plataforma y registrado por el administrador.
// Guarda cómo estaba la membresía para poder anular una captura equivocada.
model BusinessPayment {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String        @default("MXN")
  method      PaymentMethod
  months      Int
  paidAt      DateTime
  periodStart DateTime
  periodEnd   DateTime
  note        String?

  previousPeriodEnd DateTime?
  previousStatus    BusinessBillingStatus

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  voidedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([paidAt])
}

enum BusinessPlanType {
  FOUNDER
  BASIC
}

enum SubscriptionProvider {
  MANUAL
  STRIPE
  MERCADO_PAGO
}

// Bloqueo de un cliente en un negocio concreto (lo gestiona el OWNER).
// User.isBanned es el bloqueo global de la plataforma (solo ADMIN).
model BusinessCustomerBan {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
}

// Contador de intentos por clave (IP, correo, usuario) en una ventana de tiempo fija.
// Lo usa app/lib/rate-limit.ts; el cron diario borra las ventanas vencidas.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

// Acciones de administración de la plataforma
model AuditLog {
  id      String  @id @default(uuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}
